# Supabase configuration — copy to .env.local for local dev and add the same
# variables to your Vercel project (Settings → Environment Variables).

# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon/JWT key — used by lib/supabase.ts (main voting flow)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public publishable key (sb_publishable_...) — used by utils/supabase/*
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only service role key — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
